# Supabase project URL and public key: Project Settings > API in the Supabase dashboard.
# Both values end up in the browser bundle, so they must be the PUBLIC ones:
#   VITE_SUPABASE_ANON_KEY can be the publishable key (sb_publishable_...) or the legacy anon key.
#   NEVER use the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
